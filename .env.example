# AppThon — copy to .env (local) and set the same values in Vercel.
# NEVER commit a real .env, and NEVER put the Supabase service-role key here.
# Frontend code only ever sees the anon (public) key.

# Supabase project (Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Email (server-side only — set in Supabase secrets / Vercel env, NOT in .env for the browser)
# RESEND_API_KEY=re_...
# RESEND_FROM=AppThon <noreply@appthon.in>
